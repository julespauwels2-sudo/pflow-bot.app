# Copiez ce fichier en .env.local et remplissez les valeurs.
# Ne commitez JAMAIS .env.local (il est ignoré par Git).

# Supabase (étape B) : URL du projet et clé PUBLIQUE (« publishable », sb_publishable_…).
# Elles sont lues dans le navigateur ; la sécurité vient de la connexion et du RLS.
# Sans elles, l'app garde le stockage du navigateur (étape A).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Protection provisoire de l'interface (étape A). Avec Supabase configuré, elle devient
# facultative (la connexion la remplace) ; si BASIC_AUTH_PASSWORD est défini, elle reste active.
# BASIC_AUTH_USER est facultatif : s'il est vide ou absent, n'importe quel nom d'utilisateur
# est accepté et seul le mot de passe compte.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# IA de secours (étape A6). Clé côté serveur uniquement.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Étape C — serveur uniquement (Vercel), jamais dans le navigateur.
# Clé « service_role » de Supabase : utilisée seulement par les webhooks, pour les tables bot_.
SUPABASE_SERVICE_ROLE_KEY=
# Secret partagé avec PFlow Order (jeton de contact dans le lien « Commander »).
PFLOW_BOTS_SECRET=

# WhatsApp Cloud API (docs/etape-c/guide-meta.md). Sans ces trois variables, le canal est inactif.
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_GRAPH_VERSION=v24.0

# Instagram (guide-meta.md, section 9). Sans ces trois variables, le canal est inactif.
INSTAGRAM_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=

# Messages vocaux (facultatif) : openai, mistral ou deepgram, et la clé du service choisi.
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_API_KEY=

# Tests uniquement (jamais sur Vercel) : CHANNELS_STORE=memory, *_GRAPH_BASE=http://127.0.0.1:4556
