# Copiez ce fichier en .env.local et remplissez les valeurs.
# Ne commitez JAMAIS .env.local (il est ignoré par Git).

# Supabase (étape B) : URL du projet et clé PUBLIQUE (« publishable », sb_publishable_…).
# Elles sont lues dans le navigateur ; la sécurité vient de la connexion et du RLS.
# Sans elles, l'app garde le stockage du navigateur (étape A).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Protection provisoire de l'interface (étape A). Avec Supabase configuré, elle devient
# facultative (la connexion la remplace) ; si BASIC_AUTH_PASSWORD est défini, elle reste active.
# BASIC_AUTH_USER est facultatif : s'il est vide ou absent, n'importe quel nom d'utilisateur
# est accepté et seul le mot de passe compte.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# IA de secours (étape A6). Clé côté serveur uniquement.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
