diff --git a/repo/sql/qg64-paiement-offre-de-base.sql b/repo/sql/qg64-paiement-offre-de-base.sql
new file mode 100644
index 0000000..29205ee
--- /dev/null
+++ b/repo/sql/qg64-paiement-offre-de-base.sql
@@ -0,0 +1,52 @@
+-- ==========================================================================
+-- PFlow CRM, qg64 (novembre 2026) : le paiement en ligne fait partie de l'offre de base
+-- Préparé par PFlow Bots (patch 05), à relire et à jouer par Jules. Rejouable sans risque.
+--
+-- Avant : le paiement en ligne n'était possible que si l'« option » était vendue
+-- (paiement_restos.module = true). Maintenant il fait partie de l'offre de base (SumUp ou Stripe) :
+-- seul compte ce qui est réellement prêt chez le prestataire, et le réglage du resto (mode).
+--
+-- Ce fichier retire la vérification de « module » partout où elle bloquait quelque chose
+-- (greffes vérifiées : chaque point de greffe doit exister, sinon rien n'est fait).
+-- Il NE TOUCHE PAS à la facturation : le module « paiement » du catalogue, son prix, le MRR et la
+-- fiche de prix restent comme avant (décision commerciale à part).
+-- La colonne paiement_restos.module reste (plus aucune fonction ne la lit) : retour arrière possible.
+-- ==========================================================================
+
+do $$ begin
+  if to_regprocedure('public.paiement_mode_public(uuid)') is null or to_regprocedure('public.sup_evaluer()') is null
+     or to_regprocedure('public.ag_phase_paiement(public.paiement_restos)') is null then
+    raise exception 'Il manque s2-paiement.sql, s11-agents.sql ou qg55-paiement-fournisseurs.sql : les jouer d''abord';
+  end if;
+end $$;
+
+do $$
+declare g record; src text; neuf text;
+begin
+  for g in select * from (values
+    -- Le mode de paiement en vigueur (page de commande, bot) : plus de condition d'option vendue.
+    ('public.paiement_mode_public(uuid)', 'when p\.module and p\.mode in', 'when /* qg64 */ p.mode in'),
+    ('public.agent_mode_effectif(public.paiement_restos)', 'when p\.module and p\.mode in', 'when /* qg64 */ p.mode in'),
+    -- La phase (Atelier) : sans ligne paiement, « dossier à préparer » au lieu de « option non vendue ».
+    ('public.ag_phase_paiement(public.paiement_restos)', 'when l\.restaurant_id is null or not l\.module then ''non_vendu''',
+      'when l.restaurant_id is null then ''a_preparer'' /* qg64 */'),
+    ('public.ag_executer(bigint,jsonb,text)', 'where restaurant_id = r\.id and module\)', 'where restaurant_id = r.id /* qg64 */)'),
+    -- Lien d'activation : la ligne paiement est créée si besoin, au lieu d'exiger l'option.
+    ('public.paiement_activation_lien(uuid,integer)',
+      'if not exists \(select 1 from public\.paiement_restos where restaurant_id = rid and module\) then\s*raise exception ''option paiement en ligne non activee'';\s*end if;',
+      'insert into public.paiement_restos (restaurant_id, module) values (rid, true) on conflict (restaurant_id) do nothing; /* qg64 */'),
+    ('public.paiement_activation_pour(text,uuid)', 'if not pr\.module then return jsonb_build_object\(''erreur'', ''option_retiree''\); end if;', '/* qg64 : plus d''option à vérifier */'),
+    -- Réglage du mode par le resto (Dashboard) : la ligne est créée si besoin.
+    ('public.paiement_regler(uuid,text)', 'update public\.paiement_restos set mode = p_mode where restaurant_id = rid and module = true;',
+      'insert into public.paiement_restos (restaurant_id, module, mode) values (rid, true, p_mode) on conflict (restaurant_id) do update set mode = excluded.mode; /* qg64 */'),
+    -- Supervision : comptes Stripe suivis et alertes, sans condition d'option.
+    ('public.sup_comptes_stripe(text)', 'where module and stripe_compte', 'where /* qg64 */ stripe_compte'),
+    ('public.sup_evaluer()', 'pr\.module and pr\.mode <> ''coupe''', '/* qg64 */ pr.mode <> ''coupe''')
+  ) as t(f, avant, apres) loop
+    src := pg_get_functiondef(g.f::regprocedure);
+    continue when position('qg64' in src) > 0;   -- déjà fait
+    neuf := regexp_replace(src, g.avant, g.apres);
+    if neuf = src then raise exception '% : point de greffe introuvable (rien n''a été modifié)', g.f; end if;
+    execute neuf;
+  end loop;
+end $$;
diff --git a/repo/tests/qg64-paiement-base.test.js b/repo/tests/qg64-paiement-base.test.js
new file mode 100644
index 0000000..7407f6c
--- /dev/null
+++ b/repo/tests/qg64-paiement-base.test.js
@@ -0,0 +1,56 @@
+/* qg64 : le paiement en ligne fait partie de l'offre de base. L'ancienne « option vendue »
+   (paiement_restos.module) ne bloque plus rien : seul compte ce qui est prêt chez le prestataire,
+   et le réglage du resto. La facturation du module n'est pas touchée. */
+var test = require("node:test");
+var assert = require("node:assert/strict");
+var B = require("./aide-banc");
+
+var ADMIN = "11111111-1111-1111-1111-111111111111";
+var PRET = "77777777-0000-0000-0000-000000000001";     /* Stripe prêt, ancienne option NON vendue */
+var COUPE = "77777777-0000-0000-0000-000000000002";    /* Stripe prêt, le resto a coupé */
+var RIEN = "77777777-0000-0000-0000-000000000003";     /* pas encore de ligne paiement */
+var banc = null;
+async function b() {
+  if (banc) return banc;
+  banc = await B.creerBanc();
+  await banc.db.exec("insert into auth.users (id, email) values ('" + ADMIN + "', 'jules@test.fr');" +
+    "insert into public.admins (user_id) values ('" + ADMIN + "') on conflict do nothing;" +
+    "insert into public.restaurants (id, nom, statut, slug, commande_active, retrait) values" +
+    " ('" + PRET + "', 'Pret', 'actif', 'pret', true, true), ('" + COUPE + "', 'Coupe', 'actif', 'coupe', true, true), ('" + RIEN + "', 'Rien', 'signe', 'rien', true, true);" +
+    "insert into public.paiement_restos (restaurant_id, module, mode, stripe_compte, stripe_pret) values" +
+    " ('" + PRET + "', false, 'choix', 'acct_pret', true), ('" + COUPE + "', false, 'coupe', 'acct_coupe', true);");
+  return banc;
+}
+async function q(sql, params) { return (await (await b()).db.query(sql, params || [])).rows; }
+async function en(role, uid, sql, params) {
+  var d = (await b()).db;
+  await d.exec("set role " + role + "; select set_config('request.jwt.claim.sub', '" + (uid || "") + "', false);");
+  try { return (await d.query(sql, params || [])).rows; } finally { await d.exec("reset role; select set_config('request.jwt.claim.sub', '', false);"); }
+}
+
+test("qg64 : le mode en vigueur ne dépend plus de l'option vendue", async function () {
+  assert.equal((await q("select public.paiement_mode_public($1) v", [PRET]))[0].v, "choix", "Stripe prêt, option non vendue : paiement en ligne au choix");
+  assert.equal((await q("select public.paiement_mode_public($1) v", [COUPE]))[0].v, "non", "coupé par le resto : sur place");
+  assert.equal((await q("select public.paiement_mode_public($1) v", [RIEN]))[0].v, "non", "rien de prêt : sur place");
+  var vitrine = await en("anon", null, "select slug, paiement_en_ligne from public.vitrine where slug in ('pret', 'coupe') order by slug");
+  assert.deepEqual(vitrine.map(function (r) { return r.paiement_en_ligne; }), ["non", "choix"]);
+});
+
+test("qg64 : Atelier, sans ligne paiement = dossier à préparer (plus d'« option non vendue »)", async function () {
+  assert.notEqual((await q("select public.ag_phase_paiement(p) v from public.paiement_restos p where restaurant_id = $1", [PRET]))[0].v, "non_vendu");
+  assert.equal((await q("select public.ag_phase_paiement(null::public.paiement_restos) v"))[0].v, "a_preparer");
+});
+
+test("qg64 : lien d'activation et réglage du mode créent la ligne paiement si besoin", async function () {
+  var lien = (await en("authenticated", ADMIN, "select public.paiement_activation_lien($1, 10) v", [RIEN]))[0].v;
+  assert.ok(lien.token, "un lien d'activation est créé sans option vendue");
+  assert.equal((await en("authenticated", ADMIN, "select public.paiement_regler($1, 'obligatoire') v", [PRET]))[0].v, true);
+  assert.equal((await q("select mode from public.paiement_restos where restaurant_id = $1", [PRET]))[0].mode, "obligatoire");
+});
+
+test("qg64 : rejouable (le fichier ne modifie rien la deuxième fois)", async function () {
+  var fs = require("fs"), path = require("path");
+  var avant = (await q("select md5(pg_get_functiondef('public.paiement_mode_public(uuid)'::regprocedure)) h"))[0].h;
+  await (await b()).db.exec(fs.readFileSync(path.join(__dirname, "..", "sql", "qg64-paiement-offre-de-base.sql"), "utf8"));
+  assert.equal((await q("select md5(pg_get_functiondef('public.paiement_mode_public(uuid)'::regprocedure)) h"))[0].h, avant);
+});
