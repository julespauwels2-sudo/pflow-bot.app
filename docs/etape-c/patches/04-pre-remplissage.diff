diff --git a/repo/tests/pflow-bots-contact.test.js b/repo/tests/pflow-bots-contact.test.js
new file mode 100644
index 0000000..945732a
--- /dev/null
+++ b/repo/tests/pflow-bots-contact.test.js
@@ -0,0 +1,38 @@
+/* Etape C : pre-remplissage depuis le bot (api/bot-contact.js). Le jeton est fabrique ici comme le fait
+   PFlow Bots (src/channels/pflow-order/contact-token.ts). */
+var test = require("node:test");
+var assert = require("node:assert/strict");
+var crypto = require("node:crypto");
+var handler = require("../api/bot-contact.js");
+
+function jeton(contenu, secret) {
+  var iv = crypto.randomBytes(12);
+  var cle = crypto.createHash("sha256").update("pflow-bots-contact|" + secret, "utf8").digest();
+  var c = crypto.createCipheriv("aes-256-gcm", cle, iv);
+  var chiffre = Buffer.concat([c.update(JSON.stringify(contenu), "utf8"), c.final()]);
+  return Buffer.concat([iv, chiffre, c.getAuthTag()]).toString("base64url");
+}
+async function appeler(corps) {
+  var res = { statusCode: 0, headers: {}, setHeader: function (k, v) { this.headers[k] = v; }, end: function (b) { this.corps = JSON.parse(b); } };
+  await handler({ method: "POST", body: corps, headers: {} }, res);
+  return res;
+}
+var maintenant = Math.floor(Date.now() / 1000);
+
+test("jeton valide : téléphone et prénom renvoyés", async function () {
+  process.env.PFLOW_BOTS_SECRET = "secret-test";
+  var r = await appeler({ slug: "cookies-an-nou", jeton: jeton({ t: "590690123456", p: "Léa", s: "cookies-an-nou", e: maintenant + 3600 }, "secret-test") });
+  assert.deepEqual(r.corps, { ok: true, tel: "590690123456", prenom: "Léa" });
+});
+
+test("refusé : autre resto, expiré, mauvais secret, altéré ; sans secret : 503", async function () {
+  process.env.PFLOW_BOTS_SECRET = "secret-test";
+  var bon = { t: "590690123456", p: "Léa", s: "cookies-an-nou", e: maintenant + 3600 };
+  assert.equal((await appeler({ slug: "mexico", jeton: jeton(bon, "secret-test") })).corps.ok, false);
+  assert.equal((await appeler({ slug: "cookies-an-nou", jeton: jeton(Object.assign({}, bon, { e: maintenant - 1 }), "secret-test") })).corps.ok, false);
+  assert.equal((await appeler({ slug: "cookies-an-nou", jeton: jeton(bon, "autre") })).corps.ok, false);
+  var j = jeton(bon, "secret-test");
+  assert.equal((await appeler({ slug: "cookies-an-nou", jeton: j.slice(0, -2) + "AA" })).corps.ok, false);
+  delete process.env.PFLOW_BOTS_SECRET;
+  assert.equal((await appeler({ slug: "cookies-an-nou", jeton: j })).statusCode, 503);
+});
