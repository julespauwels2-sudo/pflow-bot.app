+/* PFlow, fonction serveur (etape C) : pre-remplissage de la page de commande quand le client vient du
+   bot PFlow Bots. Le bouton « Commander » du bot porte un jeton ?wa=... CHIFFRE par PFlow Bots (numero
+   WhatsApp, prenom, resto, expiration 2 h) ; cette adresse le dechiffre et renvoie { tel, prenom }.
+   Ne lit et n'ecrit rien en base. Sans PFLOW_BOTS_SECRET : 503 (la page continue sans pre-remplissage).
+
+   Format (identique a src/channels/pflow-order/contact-token.ts de PFlow Bots) :
+     jeton = base64url( iv (12 octets) | texte chiffre | tag (16 octets) ), AES-256-GCM,
+     cle = SHA-256("pflow-bots-contact|" + PFLOW_BOTS_SECRET),
+     contenu = JSON { t: numero, p: prenom, s: slug du resto, e: expiration (secondes) }. */
+
+var crypto = require("crypto");
+
+function lire(jeton, secret, slug, maintenant) {
+  try {
+    var brut = Buffer.from(String(jeton || ""), "base64url");
+    if (brut.length < 12 + 16 + 2) return null;
+    var cle = crypto.createHash("sha256").update("pflow-bots-contact|" + secret, "utf8").digest();
+    var d = crypto.createDecipheriv("aes-256-gcm", cle, brut.subarray(0, 12));
+    d.setAuthTag(brut.subarray(brut.length - 16));
+    var j = JSON.parse(Buffer.concat([d.update(brut.subarray(12, brut.length - 16)), d.final()]).toString("utf8"));
+    if (j.s !== slug || typeof j.e !== "number" || j.e < maintenant || typeof j.t !== "string" || !/^\d{6,15}$/.test(j.t)) return null;
+    return { tel: j.t, prenom: String(j.p || "").slice(0, 60) };
+  } catch (e) {
+    return null;
+  }
+}
+
+async function lireCorps(req) {
+  return await new Promise(function (ok) {
+    var b = "";
+    req.on("data", function (c) { b += c; if (b.length > 4000) req.destroy(); });
+    req.on("end", function () { ok(b); });
+    req.on("error", function () { ok(""); });
+  });
+}
+
+module.exports = async function (req, res) {
+  res.setHeader("Content-Type", "application/json; charset=utf-8");
+  res.setHeader("Cache-Control", "no-store");
+  function json(http, obj) { res.statusCode = http; res.end(JSON.stringify(obj)); }
+  if (req.method !== "POST") return json(405, { ok: false });
+  var secret = String(process.env.PFLOW_BOTS_SECRET || "").trim();
+  if (!secret) return json(503, { ok: false });
+  var corps = req.body;
+  if (!corps || typeof corps !== "object") { try { corps = JSON.parse(await lireCorps(req)); } catch (e) { corps = {}; } }
+  var slug = String(corps.slug || "").toLowerCase().replace(/[^a-z0-9-]/g, "").slice(0, 60);
+  var r = lire(corps.jeton, secret, slug, Math.floor(Date.now() / 1000));
+  if (!r) return json(200, { ok: false });
+  return json(200, { ok: true, tel: r.tel, prenom: r.prenom });
+};
+
+module.exports._interne = { lire: lire };
