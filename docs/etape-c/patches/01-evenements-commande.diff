@@ -0,0 +1,73 @@
+/* Etape C : aiguillage vers PFlow Bots (api/_bot.js). Sans PFLOW_BOTS_URL, rien ne change. */
+var test = require("node:test");
+var assert = require("node:assert/strict");
+var http = require("node:http");
+var crypto = require("node:crypto");
+
+function charger() {
+  delete require.cache[require.resolve("../api/_bot.js")];
+  return require("../api/_bot.js");
+}
+
+async function serveur(repondre) {
+  var recus = [];
+  var s = http.createServer(function (req, res) {
+    var corps = "";
+    req.on("data", function (c) { corps += c; });
+    req.on("end", function () {
+      recus.push({ url: req.url, headers: req.headers, corps: corps });
+      var r = repondre(JSON.parse(corps || "{}"));
+      res.statusCode = r.statut || 200;
+      res.setHeader("Content-Type", "application/json");
+      res.end(JSON.stringify(r.json || {}));
+    });
+  });
+  await new Promise(function (ok) { s.listen(0, "127.0.0.1", ok); });
+  return { url: "http://127.0.0.1:" + s.address().port, recus: recus, fermer: function () { return new Promise(function (ok) { s.close(ok); }); } };
+}
+
+test("sans PFLOW_BOTS_URL : aucun appel, chemin UChat", async function () {
+  delete process.env.PFLOW_BOTS_URL; delete process.env.PFLOW_BOTS_SECRET;
+  var BOT = charger();
+  assert.deepEqual(await BOT.appelerPflowBots({ type: "commande" }), { pris: false, raison: "non_configure" });
+});
+
+test("PFlow Bots prend l'événement : appel signé, réponse lue", async function () {
+  var srv = await serveur(function () { return { json: { pris: true, envois: { prete: { etat: "ok", detail: "flux Statut - Prête" } } } }; });
+  process.env.PFLOW_BOTS_URL = srv.url; process.env.PFLOW_BOTS_SECRET = "secret-test";
+  try {
+    var BOT = charger();
+    var r = await BOT.appelerPflowBots({ type: "commande", evenements: [{ pflow_order: "prete", pflow_bots: "commande_prete" }] });
+    assert.equal(r.pris, true);
+    assert.equal(r.envois.prete.etat, "ok");
+    var recu = srv.recus[0];
+    assert.equal(recu.url, "/api/webhooks/pflow-order");
+    var attendu = "sha256=" + crypto.createHmac("sha256", "secret-test").update(recu.headers["x-pflow-horodatage"] + "." + recu.corps).digest("hex");
+    assert.equal(recu.headers["x-pflow-signature"], attendu);
+    assert.ok(Math.abs(Number(recu.headers["x-pflow-horodatage"]) - Date.now() / 1000) < 10);
+  } finally { await srv.fermer(); delete process.env.PFLOW_BOTS_URL; delete process.env.PFLOW_BOTS_SECRET; }
+});
+
+test("resto pas sur PFlow Bots, erreur ou serveur injoignable : pris false (UChat comme avant)", async function () {
+  var srv = await serveur(function (j) { return j.type === "erreur" ? { statut: 500, json: { erreur: "x" } } : { json: { pris: false } }; });
+  process.env.PFLOW_BOTS_URL = srv.url; process.env.PFLOW_BOTS_SECRET = "secret-test";
+  try {
+    var BOT = charger();
+    assert.deepEqual(await BOT.appelerPflowBots({ type: "commande" }), { pris: false, raison: "pas_sur_pflow_bots" });
+    assert.deepEqual(await BOT.appelerPflowBots({ type: "erreur" }), { pris: false, raison: "http_500" });
+  } finally { await srv.fermer(); }
+  process.env.PFLOW_BOTS_URL = "http://127.0.0.1:9";
+  try {
+    var BOT2 = charger();
+    assert.deepEqual(await BOT2.appelerPflowBots({ type: "commande" }), { pris: false, raison: "injoignable" });
+  } finally { delete process.env.PFLOW_BOTS_URL; delete process.env.PFLOW_BOTS_SECRET; }
+});
+
+test("correspondance des événements et des états", function () {
+  var I = charger()._interne;
+  assert.equal(I.EVENEMENTS_PFLOW_BOTS.paiement, "commande_validee");
+  assert.equal(I.EVENEMENTS_PFLOW_BOTS.prete, "commande_prete");
+  assert.equal(I.etatPflowBots({ etat: "ok" }), "ok");
+  assert.equal(I.etatPflowBots({ etat: "ignore" }), "sans");
+  assert.equal(I.etatPflowBots(undefined), "echec");
+});
