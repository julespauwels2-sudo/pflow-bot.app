+/* ------------------------------------------------------------------ */
+/* Etape C : PFlow Bots (le nouveau bot WhatsApp de PFlow)              */
+/* Question posee AVANT UChat : « ce resto est-il sur PFlow Bots ? ».    */
+/* C'est PFlow Bots qui repond (il connait ses numeros) :                */
+/*   pris: true  -> il a traite (envoye, ou ignore : fenetre fermee)     */
+/*   pris: false -> resto pas sur PFlow Bots : chemin UChat inchange     */
+/* Injoignable, delai depasse, erreur : pris: false (UChat, comme avant). */
+/* Le CRM ne cree toujours aucun message : ce sont les flux du bot.      */
+/* ------------------------------------------------------------------ */
+var EVENEMENTS_PFLOW_BOTS = {
+  commande: "commande_validee",
+  paiement: "commande_validee",
+  en_preparation: "commande_en_preparation",
+  prete: "commande_prete",
+  annulee: "commande_annulee",
+  remboursee: "commande_remboursee",
+  annulation_refusee: "annulation_refusee",
+  rappel: "rappel_commande_prete"
+};
+
+/* Signature : HMAC-SHA256(secret, horodatage + "." + corps). PFlow Bots refuse au-dela de 5 minutes. */
+function signerPflowBots(corps, secret, horodatage) {
+  return "sha256=" + crypto.createHmac("sha256", secret).update(String(horodatage) + "." + corps, "utf8").digest("hex");
+}
+
+async function appelerPflowBots(objet) {
+  var E = env();
+  if (!E.BOTS_URL || !E.BOTS_SECRET) return { pris: false, raison: "non_configure" };
+  var corps = JSON.stringify(objet);
+  var horodatage = String(Math.floor(Date.now() / 1000));
+  try {
+    return await avecDelai(8000, async function (signal) {
+      var r = await fetch(E.BOTS_URL + "/api/webhooks/pflow-order", {
+        method: "POST", signal: signal,
+        headers: { "Content-Type": "application/json", "X-PFlow-Horodatage": horodatage, "X-PFlow-Signature": signerPflowBots(corps, E.BOTS_SECRET, horodatage) },
+        body: corps
+      });
+      var j = null;
+      try { j = await r.json(); } catch (e) { j = null; }
+      if (!r.ok || !j || j.pris !== true) return { pris: false, raison: r.ok ? "pas_sur_pflow_bots" : "http_" + r.status };
+      return { pris: true, envois: (j.envois && typeof j.envois === "object") ? j.envois : {} };
+    });
+  } catch (e) {
+    return { pris: false, raison: "injoignable" };
+  }
+}
+
+/* Etats de PFlow Bots -> etats notes par le CRM (bot_noter) */
+function etatPflowBots(x) {
+  if (x && x.etat === "ok") return "ok";
+  if (x && x.etat === "ignore") return "sans";
+  return "echec";
+}
+
+function champsEnObjet(liste) {
+  var o = {};
+  liste.forEach(function (x) { o[x.name] = x.value; });
+  return o;
+}
