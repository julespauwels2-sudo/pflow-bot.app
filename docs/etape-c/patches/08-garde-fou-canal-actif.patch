+-- qg66 (C4, PFlow Bots) : le resto a-t-il un canal PFlow Bots ACTIF ?
+-- Garde-fou absolu : PFlow Order (api/_bot.js, api/_options.js) n'envoie un evenement de commande a
+-- PFlow Bots que si cette fonction repond true. Un canal en etat « test » (numero de test Meta) ou
+-- « coupe » ne detourne JAMAIS les evenements des vraies commandes : UChat les gere comme avant.
+-- Lecture seule de bot_canaux (table de PFlow Bots, migration C) ; ne modifie rien.
+-- Rejouable. Sans la table bot_canaux : repond false (UChat).
+create or replace function public.pflow_bots_canal_actif(p_cle text, rid uuid)
+returns boolean
+language plpgsql
+stable
+security definer
+set search_path to 'public'
+as $$
+begin
+  if rid is null or not public.pont_cle_valide(p_cle) then return false; end if;
+  return exists (
+    select 1 from public.bot_canaux
+     where restaurant_id = rid and role = 'resto' and plateforme = 'whatsapp' and etat = 'actif'
+  );
+exception when undefined_table or undefined_column then
+  return false;
+end $$;
+
+-- Meme modele que les autres fonctions du pont (bot_reglages_serveur…) : appelee par l'API avec la cle
+-- publique, protegee par PONT_CLE. Ne renvoie qu'un oui / non.
+revoke all on function public.pflow_bots_canal_actif(text, uuid) from public;
+grant execute on function public.pflow_bots_canal_actif(text, uuid) to anon, authenticated, service_role;
