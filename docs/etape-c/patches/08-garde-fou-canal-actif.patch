+  await db.query("insert into public.bot_canaux (restaurant_id, compte_id, etat) values ($1, '1', 'actif'), ($2, '2', 'test'), ($3, '3', 'coupe')", [ACTIF, TEST, COUPE]);
+  /* Un compte Instagram actif ne compte pas pour les événements WhatsApp. */
+  await db.query("insert into public.bot_canaux (restaurant_id, plateforme, compte_id, etat) values ($1, 'instagram', '4', 'actif')", [TEST]);
+  assert.equal(await actif(B.CLE, ACTIF), true);
+  assert.equal(await actif(B.CLE, TEST), false, "canal en test : JAMAIS les vraies commandes");
+  assert.equal(await actif(B.CLE, COUPE), false);
+  assert.equal(await actif(B.CLE, SANS), false);
+  assert.equal(await actif("mauvaise-cle", ACTIF), false);
+  assert.equal(await actif(B.CLE, null), false);
+});
