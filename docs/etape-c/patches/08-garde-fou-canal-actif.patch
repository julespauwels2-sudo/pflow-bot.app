+/* qg66 (C4) : garde-fou de PFlow Bots. pflow_bots_canal_actif ne répond true QUE pour un resto qui a un
+   canal PFlow Bots (bot_canaux) en état « actif ». Canal « test » ou « coupe », aucun canal, table absente
+   ou mauvaise clé du pont : false → PFlow Order ne détourne rien, UChat gère la commande. */
+var test = require("node:test");
+var assert = require("node:assert/strict");
+var B = require("./aide-banc");
+
+var ACTIF = "66666666-0000-0000-0000-000000000001";
+var TEST = "66666666-0000-0000-0000-000000000002";
+var COUPE = "66666666-0000-0000-0000-000000000003";
+var SANS = "66666666-0000-0000-0000-000000000004";
+var banc = null;
+async function b() {
+  if (!banc) banc = await B.creerBanc();
+  return banc;
+}
+async function actif(cle, rid) {
+  return (await (await b()).db.query("select public.pflow_bots_canal_actif($1, $2) v", [cle, rid])).rows[0].v;
+}
+
+test("qg66 : sans la table bot_canaux (migration C de PFlow Bots absente) → false", async function () {
+  assert.equal(await actif(B.CLE, ACTIF), false);
+});
