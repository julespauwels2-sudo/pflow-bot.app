+test("qg65 : rejouable, contrôle final à deux « t »", async function () {
+  var fs = require("fs"), path = require("path");
+  var avant = (await q("select count(*)::int n from public.qg_sauvegardes where cle like 'qg65:%'"))[0].n;
+  var r = await (await b()).db.exec(fs.readFileSync(path.join(__dirname, "..", "sql", "qg65-paiement-inclus.sql"), "utf8"));
+  assert.equal((await q("select count(*)::int n from public.qg_sauvegardes where cle like 'qg65:%'"))[0].n, avant, "rien de sauvegardé deux fois");
