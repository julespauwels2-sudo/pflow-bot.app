diff --git a/repo/sql/qg65-paiement-inclus.sql b/repo/sql/qg65-paiement-inclus.sql
new file mode 100644
index 0000000..024b344
--- /dev/null
+++ b/repo/sql/qg65-paiement-inclus.sql
@@ -0,0 +1,42 @@
+-- ==========================================================================
+-- PFlow CRM, qg65 (novembre 2026) : l'option « Paiement en ligne » (79 €) est retirée
+-- Préparé par PFlow Bots (patch 07), à relire et à jouer par Jules APRÈS qg64. Rejouable sans risque.
+--
+-- Décision de Jules : personne ne paie l'option, le paiement en ligne fait partie de la formule.
+-- Comme pour les zones de livraison (qg44) : le module du catalogue passe à 0 €, « inclus dans la
+-- formule », et n'est plus proposé comme option (état « retire »). L'ancienne fiche est gardée dans
+-- qg_sauvegardes. Le fonctionnement du paiement ne dépend déjà plus de l'option (qg64).
+-- Volontairement NON touchés : pf_module_ok (le rendre vrai pour le paiement ferait créer une ligne
+-- paiement_restos pour chaque resto par pf_modules_sync) et la checklist d'installation
+-- (install_bloquants, qui ne connaît que Stripe : elle bloquerait à tort un resto sur SumUp).
+-- Aucune facture n'est touchée (aucune n'a jamais porté ce module) ; les lignes resto_modules
+-- existantes restent (prix figé ramené à 0 si besoin) pour l'historique.
+-- ==========================================================================
+
+do $$ begin
+  if to_regclass('public.modules_catalogue') is null or to_regclass('public.qg_sauvegardes') is null then
+    raise exception 'Il manque s12-modules.sql ou qg29-tarifs.sql : les jouer d''abord';
+  end if;
+  if position('qg64' in pg_get_functiondef('public.paiement_mode_public(uuid)'::regprocedure)) = 0 then
+    raise exception 'Jouer d''abord qg64-paiement-offre-de-base.sql (patch 05)';
+  end if;
+end $$;
+
+-- 1. Le module du catalogue : inclus, 0 €, plus proposé comme option (l'ancienne fiche est gardée)
+insert into public.qg_sauvegardes (cle, avant)
+select 'qg65:modules_catalogue:' || code, to_jsonb(m) from public.modules_catalogue m where code = 'paiement'
+on conflict (cle) do nothing;
+update public.modules_catalogue
+   set prix_mensuel = 0, prix_unique = 0, prix_libelle = 'inclus dans la formule', etat = 'retire', maj_le = now()
+ where code = 'paiement' and (prix_mensuel <> 0 or prix_unique <> 0 or etat <> 'retire' or prix_libelle is distinct from 'inclus dans la formule');
+
+-- 2. Les prix figés des restos : 0 € (ils le sont déjà en novembre 2026 ; gardés dans qg_sauvegardes sinon)
+insert into public.qg_sauvegardes (cle, avant)
+select 'qg65:resto_modules:paiement:' || restaurant_id, to_jsonb(m) from public.resto_modules m
+ where module = 'paiement' and coalesce(prix_mensuel, 0) <> 0
+on conflict (cle) do nothing;
+update public.resto_modules set prix_mensuel = 0 where module = 'paiement' and coalesce(prix_mensuel, 0) <> 0;
+
+-- Contrôle : une ligne, deux « t »
+select (select prix_mensuel = 0 and etat = 'retire' from public.modules_catalogue where code = 'paiement') as option_retiree,
+       not exists (select 1 from public.resto_modules where module = 'paiement' and coalesce(prix_mensuel, 0) <> 0) as prix_a_zero;
