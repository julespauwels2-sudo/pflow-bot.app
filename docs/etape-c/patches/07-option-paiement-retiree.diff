+async function b() {
+  if (banc) return banc;
+  banc = await B.creerBanc();
+  await banc.db.exec("insert into public.restaurants (id, nom, statut, slug, commande_active, retrait) values ('" + R + "', 'Inclus', 'actif', 'inclus', true, true);");
+  return banc;
+}
+async function q(sql, params) { return (await (await b()).db.query(sql, params || [])).rows; }
+
+test("qg65 : le module paiement du catalogue est inclus (0 €) et retiré des options ; l'ancienne fiche est gardée", async function () {
+  var c = (await q("select prix_mensuel::float p, prix_unique::float u, prix_libelle l, etat from public.modules_catalogue where code = 'paiement'"))[0];
+  assert.deepEqual(c, { p: 0, u: 0, l: "inclus dans la formule", etat: "retire" });
+  var avant = (await q("select avant from public.qg_sauvegardes where cle = 'qg65:modules_catalogue:paiement'"))[0];
+  assert.ok(avant, "ancienne fiche sauvegardée");
+});
+
+test("qg65 : sans effet de bord : pas de ligne paiement créée d'office, les vraies options ne changent pas", async function () {
+  assert.equal((await q("select count(*)::int n from public.paiement_restos where restaurant_id = $1", [R]))[0].n, 0);
